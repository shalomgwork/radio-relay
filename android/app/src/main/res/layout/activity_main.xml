<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="#0E0E10">

    <!-- header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="10dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Radio Relay" android:textColor="#F2F2F2" android:textSize="16sp" android:textStyle="bold"/>
        <View android:id="@+id/rxDot" android:layout_width="7dp" android:layout_height="7dp"
            android:background="@drawable/rx_dot" android:layout_marginEnd="7dp" android:visibility="invisible"/>
        <View android:id="@+id/dot" android:layout_width="9dp" android:layout_height="9dp"
            android:background="@drawable/status_dot" android:layout_marginEnd="6dp"/>
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Off" android:textColor="#A0A0A5" android:textSize="12sp"/>
    </LinearLayout>

    <!-- connect / disconnect -->
    <LinearLayout android:id="@+id/connect" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/menu_row"
        android:padding="14dp" android:layout_marginBottom="8dp" android:focusable="true" android:clickable="true"
        android:nextFocusUp="@id/connect">
        <View android:id="@+id/connectDot" android:layout_width="12dp" android:layout_height="12dp"
            android:background="@drawable/status_dot" android:layout_marginEnd="10dp"/>
        <TextView android:id="@+id/connectLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Connect" android:textColor="#F2F2F2" android:textSize="18sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- active server -->
    <LinearLayout android:id="@+id/servers" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/menu_row"
        android:padding="14dp" android:layout_marginBottom="8dp" android:focusable="true" android:clickable="true">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SERVER" android:textColor="#7A7A80" android:textSize="10sp" android:letterSpacing="0.1"/>
            <TextView android:id="@+id/serverValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="None" android:textColor="#F2F2F2" android:textSize="16sp" android:singleLine="true"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="›" android:textColor="#7A7A80" android:textSize="22sp"/>
    </LinearLayout>

    <!-- history -->
    <LinearLayout android:id="@+id/history" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/menu_row"
        android:padding="14dp" android:focusable="true" android:clickable="true">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="History" android:textColor="#F2F2F2" android:textSize="16sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="›" android:textColor="#7A7A80" android:textSize="22sp"/>
    </LinearLayout>
</LinearLayout>
