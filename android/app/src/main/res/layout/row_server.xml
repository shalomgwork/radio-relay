<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingHorizontal="12dp" android:paddingVertical="12dp" android:minHeight="48dp">
    <View android:id="@+id/activeDot" android:layout_width="9dp" android:layout_height="9dp"
        android:background="@drawable/active_dot" android:layout_marginEnd="10dp" android:visibility="invisible"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Server" android:textColor="#F2F2F2" android:textSize="16sp" android:singleLine="true"/>
        <TextView android:id="@+id/host" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="100.x.x.x" android:textColor="#7A7A80" android:textSize="12sp" android:singleLine="true"/>
    </LinearLayout>
</LinearLayout>
