PORT=5000
PTT_MODE=cm108
PTT_PREROLL_MS=200
PTT_HANG_MS=300
RX_GATE_RMS=300
RX_HANG_MS=500
#AUDIO_DEV=USB Audio       # auto-detected; index or name substring from `python hwtest.py devices`
# Recording: one WAV per transmission in REC_DIR, kept REC_DAYS days (0 = off), served on REC_PORT (default PORT+1)
#REC_DAYS=14
#REC_DIR=/Users/zalmy/Projects/radio-relay/recordings
#REC_PORT=5001

# Browser client: a web listen/talk page served on WEB_PORT (default PORT+2 = 5002).
# Open http://<server-tailscale-ip>:5002/ in a browser. Listening works over plain http;
# transmitting needs the mic, which browsers only allow on a secure page (Tailscale HTTPS,
# or trust the origin in chrome://flags/#unsafely-treat-insecure-origin-as-secure).
#WEB_PORT=5002
