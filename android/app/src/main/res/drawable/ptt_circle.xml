<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval"><solid android:color="#2A2A2A"/><stroke android:width="2dp" android:color="#3A3A3A"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#E53935"/><stroke android:width="6dp" android:color="#66E53935"/></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#2E7D32"/><stroke android:width="6dp" android:color="#332E7D32"/></shape>
    </item>
</selector>
